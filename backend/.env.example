# Server
NODE_ENV=development
PORT=5000

# Database
MONGO_URI=mongodb://127.0.0.1:27017/ecd_platform

# Auth — CHANGE THESE IN PRODUCTION
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-this-to-a-different-long-random-string
JWT_REFRESH_EXPIRES_IN=30d

# CORS — comma-separated list of allowed origins
CORS_ORIGIN=https://eris-mes.vercel.app

# File uploads
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=8

# Cloudinary — required for photo uploads (children, reports, visits,
# health alerts, avatars). Create a free account at https://cloudinary.com,
# then copy these three values from your Cloudinary dashboard.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional — the root folder uploaded images are organized under in Cloudinary.
CLOUDINARY_UPLOAD_FOLDER=eris-mes

# Web Push (optional — generate with: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.org
